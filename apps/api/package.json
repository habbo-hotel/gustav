{
  "name": "@gustav/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "sh -c 'typeorm-ts-node-commonjs migration:generate -d ./src/database/data-source.ts ./src/database/migrations/\"$0\"'",
    "migration:up": "typeorm-ts-node-commonjs migration:run -d ./src/database/data-source.ts",
    "migration:down": "typeorm-ts-node-commonjs migration:revert -d ./src/database/data-source.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:fix": "pnpm exec eslint \"{src,test}/**/*.ts\" --fix --no-error-on-unmatched-pattern && pnpm exec prettier \"{src,test}/**/*.ts\" --write",
    "test": "jest",
    "test:e2e": "jest --config ./src/jest-e2e.json"
  },
  "dependencies": {
    "@gustav/ms3-database-plugin": "workspace:*",
    "@gustav/types": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@sendgrid/mail": "^8.1.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "mysql2": "^3.22.4",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@gustav/config-eslint": "workspace:*",
    "@gustav/config-typescript": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-discord": "^0.1.13",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.0.0",
    "eslint": "8.57.1",
    "gts": "5.3.1",
    "jest": "^30.0.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.(spec|e2e)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
